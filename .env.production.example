APP_ENV=production
NEXT_PUBLIC_APP_URL=https://app.example.com

NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<production-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<production-service-role-key>
SUPABASE_PROJECT_REF=<production-project-ref>
SUPABASE_ACCESS_TOKEN=<production-ci-access-token>

INSTAGRAM_APP_ID=<production-instagram-app-id>
INSTAGRAM_APP_SECRET=<production-instagram-app-secret>
INSTAGRAM_API_VERSION=v23.0
INSTAGRAM_OAUTH_REDIRECT_URI=https://app.example.com/api/integrations/meta/oauth/callback
INSTAGRAM_REQUIRED_SCOPES=instagram_business_basic,instagram_business_content_publish
INSTAGRAM_AUTHORIZATION_URL=https://www.instagram.com/oauth/authorize
META_TOKEN_ENCRYPTION_KEY=<production-token-encryption-key-with-32-plus-chars>
META_PUBLISH_MEDIA_URL_TTL_SECONDS=3600
META_CONTAINER_POLL_ATTEMPTS=8
META_CONTAINER_POLL_INTERVAL_MS=3000
META_PUBLISHING_LIMIT_PER_24H=100
META_RATE_LIMIT_RETRY_AFTER_MINUTES=60
META_PROCESSING_RETRY_AFTER_MINUTES=5

WORKER_SECRET=<production-worker-secret>
HEALTHCHECK_URLS=https://app.example.com,https://app.example.com/api/admin/performance/health
ALLOW_REMOTE_MIGRATIONS=false
MIGRATION_APPROVAL_ID=
